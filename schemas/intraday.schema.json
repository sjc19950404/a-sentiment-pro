{
  "$comment": [
    "前后端接口契约 · intraday.json（V5.3 同步机制 · 2026-10-05）",
    "生产方：scripts/snapshot_intraday.mjs（绝不触碰 archive.json；仅 meta.phase==='live' 时前端才拉）",
    "消费方：app.js loadIntraday——kind:'intraday' 是防串档哨兵（拉到别的档直接判失败）"
  ],
  "type": "object",
  "required": ["kind", "version", "tradeDate", "capturedAtBJ", "hot", "pools", "breadth"],
  "properties": {
    "kind": { "type": "string", "const": "intraday" },
    "version": { "type": "number" },
    "tradeDate": { "type": "string" },
    "capturedAtBJ": { "type": "string" },
    "prevCapturedAtBJ": { "type": ["string", "null"] },
    "phase": { "type": "string" },
    "caliberNote": { "type": ["string", "null"] },
    "hot": {
      "type": ["object", "null"],
      "required": ["count"],
      "properties": {
        "count": { "type": "number" },
        "srcDate": { "type": ["string", "null"] },
        "rows": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "code": { "type": "string" },
              "name": { "type": ["string", "null"] },
              "reason": { "type": ["string", "null"] },
              "close": { "type": ["number", "null"] },
              "zhangfu": { "type": ["number", "null"] },
              "huanshou": { "type": ["number", "null"] },
              "pe_ttm": { "type": ["number", "null"] },
              "pb": { "type": ["number", "null"] },
              "liangbi": { "type": ["number", "null"] },
              "main_net": { "type": ["number", "null"] },
              "avg_price": {
                "type": ["number", "null"],
                "deprecated": true,
                "$comment": "⚠ 弃用（2026-10-20）：旧值来源东财 f9，实为市盈率(PE)，非分时均价。源头 src/intraday_node.mjs 已置 null，待 VWAP 公式确认后重建。消费方（作战指令）不得再据『现价>avg_price』判信号。"
              },
              "date": { "type": ["string", "null"] }
            }
          }
        }
      }
    },
    "pools": {
      "type": ["object", "null"],
      "required": ["zt", "zb", "dt", "max_lb", "lb2"],
      "properties": {
        "zt": { "type": ["number", "null"] },
        "zb": { "type": ["number", "null"] },
        "dt": { "type": ["number", "null"] },
        "max_lb": { "type": ["number", "null"] },
        "lb2": { "type": ["number", "null"] },
        "seal_pct": { "type": ["number", "null"] },
        "zt_codes": { "type": "array" },
        "zt_lb": { "type": ["object", "null"], "$comment": "v3（2026-10-10 双池拆分）：code→连板数映射（东财 getTopicZTPool lbc），盘中连板池判定唯一依据。可选：旧快照（v2）缺席 = null，连板池报因不猜测" },
        "zt_lbw": { "type": ["object", "null"], "$comment": "v4（2026-10-23 用户校准）：code→窗口连板数映射（近5交易日涨停天数，N天M板口径）。lbc 只数连续板会漏 5天3板/4天2板；两口径并列，交易语义仍用 zt_lb。旧快照缺席 = null，前端回退 zt_lb" },
        "lbw2": { "type": ["number", "null"], "$comment": "v4（2026-10-23）：窗口口径连板梯队只数（近5交易日涨停天数≥2）" },
        "max_lbw": { "type": ["number", "null"], "$comment": "v4（2026-10-23）：窗口口径最高板数（近5交易日涨停天数最大值）" },
        "zt_dtd": { "type": ["object", "null"], "$comment": "v4（2026-10-23 用户校准）：地天板稀疏映射（code→true，盘中触及跌停且收盘封回涨停）。行情缺失整批时 null，不猜" },
        "dtd_count": { "type": ["number", "null"], "$comment": "v4（2026-10-23）：地天板只数" },
        "zt_detail": { "type": ["array", "null"], "$comment": "v3（2026-10-10 滚动情绪）：涨停池每股明细 {c,lbc,lbw,zbc,hybk,fbt,fund}，emotion_cycle 六指标的盘中原料（与收盘口径 ztpool_history 同源同构）", "items": { "type": "object" } }
      }
    },
    "rolling": {
      "type": ["object", "null"],
      "$comment": "v3（2026-10-10 用户指令）：tick 每拍生成的滚动候选池——复用报告层 buildIntradayPool 纯函数（页面/推送同构）+ 实时六状态情绪 + 收盘倒计时降级标记。推送时点与入库流程零改动；旧快照缺席 = null",
      "properties": {
        "generatedAtBJ": { "type": "string" },
        "minutes_to_close": { "type": ["number", "null"], "$comment": "距 15:00 收盘剩余分钟；<30 时 trend_pool_mode=tomorrow_watch" },
        "trend_pool_mode": { "type": "string", "enum": ["trend", "tomorrow_watch"] },
        "streak_pool": { "type": "array" },
        "trend_pool": { "type": "array" },
        "basis": { "type": "string" },
        "streak_basis": { "type": "string" },
        "emotion": { "type": ["object", "null"], "$comment": "computeEmotion 输出 {date,emotion,score,metrics}；no_data → null（宁缺毋假）" }
      }
    },
    "prevPools": {
      "type": ["object", "null"],
      "$comment": "上一拍成功快照的池对比面：只存前端实际消费的三字段（app.js 盘中卡 zt/zb/seal_pct 的 delta 对比；dt/max_lb/lb2 当前值直显不做对比）。原五字段（zt/zb/dt/max_lb/lb2）是 33482e5 契约先行时的预设，4bb6965 落地时按消费面实现为三字段，2026-10-08 契约对齐实现（节后首日 prevPools 首次非 null 暴露缺口）",
      "required": ["zt", "zb", "seal_pct"],
      "properties": {
        "zt": { "type": ["number", "null"] },
        "zb": { "type": ["number", "null"] },
        "seal_pct": { "type": ["number", "null"] }
      }
    },
    "breadth": { "type": ["object", "null"] },
    "screener": {
      "type": ["object", "null"],
      "$comment": "全市场筛选榜（任务二盘中候选池主数据源 · 2026-10-09 拆分）：东财 clist 主力净流入降序前 100，自带量比/PE-TTM/PB/行业；抓取失败 = null（报告层回落 hot 榜口径并报因，宁缺毋假）",
      "required": ["count", "rows"],
      "properties": {
        "count": { "type": "number" },
        "rows": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["code", "name", "close", "change_pct", "liangbi", "pe_ttm", "pb", "main_net", "industry"],
            "properties": {
              "code": { "type": "string" },
              "name": { "type": ["string", "null"] },
              "close": { "type": ["number", "null"] },
              "change_pct": { "type": ["number", "null"] },
              "huanshou": { "type": ["number", "null"] },
              "liangbi": { "type": ["number", "null"] },
              "pe_ttm": { "type": ["number", "null"] },
              "pb": { "type": ["number", "null"] },
              "main_net": { "type": ["number", "null"] },
              "industry": { "type": ["string", "null"] }
            }
          }
        }
      }
    },
    "sourcesFailed": { "type": "array" }
  }
}
